{
  "manifest_version": 3,
  "name": "WebAuthn DevTools",
  "version": "1.0.1",
  "description": "Capture and inspect WebAuthn API calls in DevTools",

  "permissions": [],

  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "devtools_page": "devtools.html",

  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "webauthn-devtools@example.com",
      "strict_min_version": "109.0"
    }
  }
}
